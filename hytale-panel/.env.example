# ============================================================
# Hytale Server Management Panel — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# The install.sh script generates secrets automatically.
# ============================================================

# ─── Database ───────────────────────────────────────────────
DB_PASSWORD=

# ─── Docker / Host Integration ──────────────────────────────
# Shared numeric GID for the helper socket directory + API container.
PANEL_SOCKET_GID=2001
# Override these if 3000/4000/5432 are already in use on the VPS host.
WEB_HOST_PORT=3000
API_HOST_PORT=4000
POSTGRES_HOST_PORT=5432

# ─── API Server ─────────────────────────────────────────────
NODE_ENV=production
# Sessions are DB-backed opaque tokens; SESSION_SECRET is reserved for future
# cookie signing and is not currently consumed at runtime. Still required at
# startup so enabling signing later won't be a breaking env change.
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=4
SESSION_IDLE_TIMEOUT_MINUTES=60
ADMIN_SESSION_IDLE_TIMEOUT_MINUTES=15
COOKIE_DOMAIN=
CSRF_SECRET=

# ─── Helper Service Communication ──────────────────────────
HELPER_HMAC_SECRET=
# Container-visible helper socket path. The host helper itself listens on
# /opt/hytale-panel/run/hytale-helper.sock and Docker bind-mounts that into the
# API container at /run/hytale-helper/hytale-helper.sock.
HELPER_SOCKET_PATH=/run/hytale-helper/hytale-helper.sock
# Max raw mod upload size. Uploads are staged under /opt/hytale-panel-data/mod-upload-staging.
MAX_MOD_UPLOAD_SIZE_MB=150

# ─── Panel Update Checker ──────────────────────────────────
# The dashboard polls GitHub Releases on the configured repo to surface a
# "Panel Updates" card to admins. Read-only — never installs anything.
# If the repo is private, set GITHUB_UPDATE_TOKEN to a fine-grained PAT with
# read-only Contents access. The token stays server-side and is never sent
# to the browser or persisted.
PANEL_UPDATE_REPO=hicham-pkg/Hytale-Server-Management-Panel
PANEL_UPDATE_CACHE_MINUTES=60
# GITHUB_UPDATE_TOKEN=

# ─── Panel Updater (V2) ────────────────────────────────────
# One-click panel install runs through a host-side systemd templated unit
# (hytale-panel-updater@<jobId>.service). The API container only orchestrates
# and reads job status/logs from a read-only bind mount; it never invokes
# sudo, systemctl, docker, or rsync.
#
# Master kill switch. true (default) = the dashboard's "Update Panel" button
# is shown to admins. false = button hidden and start RPC rejected.
# There is no scheduled / unattended auto-install — installs require a
# manual click.
PANEL_UPDATE_INSTALL_ENABLED=true
# Cap on the rolling backup count under /opt/hytale-panel-backups (2-50).
PANEL_UPDATE_BACKUP_RETENTION=5
# Hard cap on the source archive download size (MB). 1-2048.
PANEL_UPDATE_MAX_DOWNLOAD_MB=300
# Run pnpm test inside the staged source before applying. Slow + needs
# devDependencies; default false. Build + compose-config + doctor still run.
PANEL_UPDATE_RUN_TESTS=false
# Per-request log tail cap returned to the dashboard (bytes, 1024-10485760).
PANEL_UPDATE_MAX_LOG_BYTES=2097152

# ─── Reverse Proxy ──────────────────────────────────────────
# For first private testing via SSH tunnel, these can be:
# CORS_ORIGIN=http://localhost:43000
# WS_ALLOWED_ORIGINS=http://localhost:43000
# In production, WS_ALLOWED_ORIGINS must be set or the console WebSocket is
# rejected by design.
# Trust local reverse-proxy hops, including Docker bridge/private subnets.
TRUST_PROXY=loopback, linklocal, uniquelocal
CORS_ORIGIN=https://panel.yourdomain.com
WS_ALLOWED_ORIGINS=https://panel.yourdomain.com

# ─── Rate Limiting ──────────────────────────────────────────
MAX_FAILED_LOGINS=10
LOCKOUT_DURATION_MINUTES=30
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ─── Retention ──────────────────────────────────────────────
AUDIT_LOG_RETENTION_DAYS=90
CRASH_LOG_RETENTION_DAYS=30

# ─── Helper Service (.env for /opt/hytale-panel/helper/) ────
# These are used by the helper service running on the host.
# HELPER_SOCKET_PATH=/opt/hytale-panel/run/hytale-helper.sock
# HELPER_HMAC_SECRET=
# HYTALE_ROOT=/opt/hytale
# BACKUP_PATH=/opt/hytale-backups
# MODS_PATH=/opt/hytale/mods
# DISABLED_MODS_PATH=/opt/hytale/mods-disabled
# MOD_UPLOAD_STAGING_PATH=/opt/hytale-panel-data/mod-upload-staging
# MOD_BACKUP_PATH=/opt/hytale/mod-backups
# MOD_BACKUP_RETENTION=10
# HYTALE_SERVICE_NAME must match systemd/hytale-helper.sudoers and the journal wrapper unless you customize both.
# HYTALE_SERVICE_NAME=hytale-tmux.service
# TMUX_SESSION=hytale
# WHITELIST_PATH=/opt/hytale/Server/whitelist.json
# BANS_PATH=/opt/hytale/Server/bans.json
# HYTALE_SAVE_ROOT=/opt/hytale/Server/universe
# WORLDS_PATH=/opt/hytale/Server/worlds

# ─── Web Frontend ──────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://api:4000
